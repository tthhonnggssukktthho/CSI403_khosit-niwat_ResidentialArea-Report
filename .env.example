# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# --- Groq AI API ---
GROQ_API_KEY=your_groq_api_key_here
# Model: llama-3.3-70b-versatile (ฟรี, เร็ว)
GROQ_AI_MODEL=llama-3.3-70b-versatile

# --- Google Sheets ---
# Spreadsheet ID จาก URL: /d/{ID}/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB_NAME=Sheet1
GOOGLE_SHEET_INFO_TAB=Sheet2

# --- n8n Webhook ---
N8N_WEBHOOK_PATH=line-webhook
# Production URL ที่ใส่ใน LINE Console
N8N_BASE_URL=https://n8n-hub.minddatatech.com

# --- Admin LINE User IDs (คั่นด้วย ,) ---
ADMIN_LINE_IDS=Uxxxxxxxxxxxxxxxxx,คนที่2Uyyyyyyyyyyyyyyyyy

# --- Billing Rate ---
WATER_RATE=12
ELEC_RATE=4